{
  "date_order": "DMY",
  "low_confidence_threshold": 0.85,
  "max_label_length": 40,
  "_labels_note": "Labels are compared lowercase without spaces, and are listed in priority order (first = preferred).",

  "contract_title_keywords": [
    "AGREEMENT", "CONTRACT", "DEED", "MEMORANDUM", "PROPOSAL", "STATEMENT OF WORK", "ORDER FORM", "INVOICE", "RECEIPT", "QUOTATION", "QUOTE", "PURCHASE ORDER", "BILL OF LADING", "ESTIMATE", "WORK ORDER", "SERVICE AGREEMENT", "NON-DISCLOSURE", "NDA", "TERM SHEET", "LEASE"
  ],

  "fields": [
    {"section": "document_info", "key": "execution_date", "type": "date", "match": "contains", "labels": []},
    {"section": "document_info", "key": "expiry_date", "type": "date", "match": "contains", "labels": []},
    {"section": "document_info", "key": "validity_tenure", "type": "text", "match": "contains", "labels": []},
    {"section": "document_info", "key": "mrc_otc", "type": "text", "match": "contains", "labels": []},
    {"section": "document_info", "key": "termination_clause", "type": "text", "match": "contains", "labels": []}
