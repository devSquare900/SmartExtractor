{
  "date_order": "DMY",
  "low_confidence_threshold": 0.85,
  "max_label_length": 40,
  "_labels_note": "Labels are compared lowercase without spaces, and are listed in priority order (first = preferred).",

  "contract_title_keywords": [
    "AGREEMENT", "CONTRACT", "DEED", "MEMORANDUM", "PROPOSAL", "STATEMENT OF WORK", "ORDER FORM", "INVOICE", "RECEIPT", "QUOTATION", "QUOTE", "PURCHASE ORDER", "BILL OF LADING", "ESTIMATE", "WORK ORDER", "SERVICE AGREEMENT", "NON-DISCLOSURE", "NDA", "TERM SHEET", "LEASE"
  ],

  "fields": [
    {"section": "customer_info", "key": "name", "type": "text", "match": "contains",
     "labels": ["nameofcustomer", "customername", "customer", "client", "clientname", "billedto", "soldto", "billto", "buyer", "buyername", "purchaser", "purchasername", "accountname", "attention", "attn", "recipient", "preparedfor", "issuedto", "to", "lessee", "tenant"]},
    {"section": "customer_info", "key": "billing_address", "type": "text", "match": "contains",
     "labels": ["billingaddress", "address", "shippingaddress", "shipto", "customeraddress", "location", "facility", "deliveryaddress", "siteaddress", "street", "streetaddress", "registeredaddress", "officeaddress", "mailaddress", "postaladdress", "ship-to", "bill-to", "destination"]},
    {"section": "customer_info", "key": "poc_contact", "type": "text", "match": "contains",
     "labels": ["pocname", "contactnumber", "contact", "phone", "phonenumber", "telephone", "mobile", "cell", "tel", "ph", "fax", "faxnumber", "cellphone", "mobilephone", "contactperson", "pointofcontact", "attentionto", "contactdetails", "representative", "rep", "direct", "office"]},
    {"section": "customer_info", "key": "email", "type": "text", "match": "contains",
     "labels": ["emailaddress", "email", "e-mail", "mail", "contactemail", "emailid", "electronicmail", "webmail", "supportemail", "salesemail", "billingemail"]},

    {"section": "document_info", "key": "date", "type": "date", "match": "exact",
     "labels": ["date", "dated", "invoicedate", "contractdate", "effectivedate", "issuedate", "billingdate", "orderdate", "creationdate", "documentdate", "dateofissue", "dateofinvoice", "submissiondate", "startdate", "enddate", "expirydate", "duedate", "paymentdate", "validuntil", "shipdate"]},
    {"section": "document_info", "key": "doc_number", "type": "text", "match": "contains",
     "labels": ["invoice#", "invoicenumber", "invoiceno", "contract#", "contractnumber", "contractno", "billnumber", "billno", "receiptno", "receiptnumber", "formno", "formnumber", "document#", "documentnumber", "documentno", "referencenumber", "referenceno", "ref#", "ref", "id", "tracking#", "trackingno", "ordernumber", "order#", "agreement#", "agreementno"]},
    {"section": "document_info", "key": "amount", "type": "amount", "match": "exact",
     "labels": ["grandtotal", "totalamount", "totalpayable", "amountdue", "totaldue", "netamount", "total", "amount", "balance", "balancedue", "subtotal", "paymentdue", "totalinvoice", "invoiceamount", "grossamount", "finalamount", "dueamount", "payableamount", "sum", "totalprice", "estimatedtotal", "cost", "totalcost"]},
    {"section": "document_info", "key": "po_number", "type": "text", "match": "contains",
     "labels": ["po#", "ponumber", "pono", "purchaseorder", "purchaseordernumber", "order#", "orderno", "ordernumber", "po", "purchaseorder#", "purchaseorderno", "customerpo", "clientpo", "buyerpo", "requisition#", "req#", "salesorder#", "so#"]},

    {"section": null, "key": "service_provider", "type": "text", "match": "contains",
     "labels": ["serviceprovider", "accountmanager", "vendor", "supplier", "merchant", "companyname", "from", "contractor", "subcontractor", "seller", "provider", "distributor", "biller", "payee", "remitto", "issuedby", "preparedby", "company", "organization", "agency", "lessor", "landlord"]}
  ],

  "line_items": {
    "start_labels": ["scopeofwork", "deliverables", "annexure", "lineitems", "items", "description", "services", "products", "particulars", "details", "billofmaterials", "pricing", "charges", "fees", "orderdetails"],
    "stop_keywords": ["monthly recurring", "grand total", "authorized signatory", "signatures", "payment", "confidentiality", "terms and conditions", "notes", "subtotal", "total amount", "tax", "vat", "approved by", "thank you", "remittance", "payment terms"],
    "ignore_keywords": ["legally binding"],
    "header_words": ["item", "sr", "s.no", "no.", "#", "description", "service", "qty", "quantity", "unit", "rate", "price", "amount", "total", "mrc", "otc", "uom", "part", "sku", "code", "product", "particulars", "hrs", "hours", "discount", "tax", "net", "gross", "cost", "subtotal"]
  }
}
